{
  "schemaVersion": 2,
  "id": "flight-stats",
  "systemId": "flight-portal",
  "name": "飞行经历查询接口",
  "navigationGroup": "综合报表",
  "description": "按员工号和日期范围单次查询门户当前返回的全部飞行经历与起落数字段。",
  "baseUrl": "https://ieb.csair.com",
  "navigationUrl": "https://ieb.csair.com/newieb/flytime/showFlytimeManyQuery",
  "cookies": [
    { "name": "JSESSIONID", "required": true, "description": "门户 Session Cookie，HttpOnly" },
    { "name": "iebJSid", "required": true, "description": "IEB 会话 Cookie，HttpOnly" }
  ],
  "commonHeaders": [
    { "name": "Accept", "value": "text/html, */*; q=0.01", "description": "HTML 表格响应" },
    { "name": "Referer", "value": "https://ieb.csair.com/index/index", "description": "已验证请求来源" },
    { "name": "X-Requested-With", "value": "XMLHttpRequest", "description": "门户 XHR 标记" },
    { "name": "Accept-Language", "value": "zh-CN,zh;q=0.9", "description": "中文页面响应" }
  ],
  "groups": [
    { "id": "business", "name": "飞行门户" }
  ],
  "endpoints": [
    {
      "id": "query",
      "groupId": "business",
      "name": "飞行经历查询接口",
      "summary": "一次真实 GET 同时返回飞行时间、飞行经历、左座经历、起落数及门户当前提供的其他字段。",
      "risk": "read",
      "method": "GET",
      "path": "/newieb/flytime/showFlytimeManyQueryList",
      "execution": {
        "kind": "direct-http",
        "steps": [
          { "id": "request", "requestRef": "$endpoint", "role": "primary", "cardinality": "once" }
        ]
      },
      "parameters": [
        { "name": "staffNum", "in": "query", "label": "员工号", "type": "text", "required": true, "placeholder": "六位员工号", "description": "结果按员工号唯一归属" },
        { "name": "startStr", "in": "query", "label": "开始日期", "type": "date", "required": true, "placeholder": "YYYY-MM-DD", "description": "标准格式 YYYY-MM-DD，例如 2026-01-01" },
        { "name": "endStr", "in": "query", "label": "结束日期", "type": "date", "required": true, "placeholder": "YYYY-MM-DD", "description": "标准格式 YYYY-MM-DD，例如 2026-08-23" },
        { "name": "activeStatusArray", "in": "query", "label": "在职状态", "type": "text", "default": "ZAIZHI", "fixed": true, "description": "页面固定值" },
        { "name": "dateType", "in": "query", "label": "日期类型", "type": "text", "default": "5", "fixed": true, "description": "页面按日查询值" },
        { "name": "exportType", "in": "query", "label": "导出类型", "type": "text", "default": "1", "fixed": true, "description": "页面固定值" },
        { "name": "page", "in": "query", "label": "页码", "type": "number", "default": "1", "fixed": true, "description": "单次查询第一页" },
        { "name": "currentStr", "in": "query", "label": "防缓存参数", "type": "text", "auto": "timestamp", "fixed": true, "description": "执行时生成" },
        { "name": "fleetCdArray1", "in": "query", "label": "机队筛选 1", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "fleetCdArray", "in": "query", "label": "机队筛选", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "chnDescArray", "in": "query", "label": "技术信息筛选", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "primaryBaseArray", "in": "query", "label": "注册基地筛选", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "baseArray", "in": "query", "label": "运行基地筛选", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "singlefleetCdArray", "in": "query", "label": "单机队筛选", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" },
        { "name": "chnDescArray1", "in": "query", "label": "技术信息筛选 1", "type": "text", "default": "", "fixed": true, "includeWhenEmpty": true, "description": "保留页面空参数" }
      ],
      "response": {
        "format": "HTML table",
        "statuses": [
          { "code": 200, "description": "HTML 表格；仍需排除登录页、校验表头并按员工号唯一归属" }
        ],
        "fields": [
          { "name": "员工号", "type": "string", "description": "查询人员主标识" },
          { "name": "姓名", "type": "string", "description": "门户姓名" },
          { "name": "注册基地", "type": "string", "description": "注册基地" },
          { "name": "运行基地", "type": "string", "description": "运行基地" },
          { "name": "技术信息", "type": "string", "description": "技术信息" },
          { "name": "开始日期", "type": "date", "description": "统计开始日期" },
          { "name": "结束日期", "type": "date", "description": "统计结束日期" },
          { "name": "飞行时间", "type": "duration", "description": "门户原始时长" },
          { "name": "飞行经历", "type": "duration", "description": "门户原始时长" },
          { "name": "航段数", "type": "number", "description": "航段数量" },
          { "name": "夜航经历", "type": "duration", "description": "夜航时长" },
          { "name": "左座经历", "type": "duration", "description": "左座时长" },
          { "name": "右座经历", "type": "duration", "description": "右座时长" },
          { "name": "模拟机", "type": "duration", "description": "模拟机时长" },
          { "name": "本场时间", "type": "duration", "description": "本场时长" },
          { "name": "起落总数", "type": "number", "description": "全部起落" },
          { "name": "航线起落", "type": "number", "description": "航线起落" },
          { "name": "本场起落", "type": "number", "description": "本场起落" },
          { "name": "人工飞行时间", "type": "duration", "description": "人工飞行时长" }
        ],
        "example": "{\"员工号\":\"900001\",\"姓名\":\"示例人员\",\"飞行时间\":\"12:30\",\"起落总数\":\"8\"}"
      }
    }
  ],
  "requestDefinitions": [
    {
      "id": "identity-page",
      "name": "当前登录人信息",
      "purpose": "读取当前 IEB Session 对应的员工号和姓名。",
      "risk": "read",
      "method": "GET",
      "path": "/index/index",
      "parameters": [],
      "response": "有效响应为 HTTP 200，最终路径不是 /login；员工号来自 .detailInfo .empid span[title]，姓名来自 #personalInfo .name-txt。"
    },
    {
      "id": "query-page",
      "name": "会话验证与查询页",
      "purpose": "验证飞行门户 Cookie 登录态，并确认飞行经历查询表单及真实查询 action。",
      "risk": "read",
      "method": "GET",
      "path": "/newieb/flytime/showFlytimeManyQuery",
      "parameters": [],
      "response": "有效响应为 HTTP 200，最终路径不是 /login，存在 #showflyTimeExperienceQueryForm，form action 为 /newieb/flytime/showFlytimeManyQueryList。"
    }
  ],
  "technicalNotes": [
    "当前只需要 JSESSIONID 与 iebJSid，均为 HttpOnly Session Cookie。",
    "当前未观察到 CSRF、__VIEWSTATE、动态签名或 Authorization Header。",
    "四种业务查询范围不改变门户请求；门户一次返回全部字段，范围筛选属于独立批量 APP 的展示与导出职责。",
    "HTTP 200 可能仍是登录页或异常表格，不能单独作为成功依据。"
  ]
}
